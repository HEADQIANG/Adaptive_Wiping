+import numpy as np
+
+from robosuite.models.robots.manipulators.manipulator_model import ManipulatorModel
+from robosuite.utils.mjcf_utils import xml_path_completion
+
+
+class AirbotPlay(ManipulatorModel):
+    """Airbot Play 6-DoF fixed-base manipulator for wiping demonstrations."""
+
+    arms = ["right"]
+
+    def __init__(self, idn=0):
+        super().__init__(xml_path_completion("robots/airbot_play/robot.xml"), idn=idn)
+
+    @property
+    def default_base(self):
+        return "RethinkMount"
+
+    @property
+    def default_gripper(self):
+        return {"right": "WipingGripper"}
+
+    @property
+    def default_controller_config(self):
+        return {"right": "default_airbot_play"}
+
+    @property
+    def init_qpos(self):
+        return np.array([0.0, -1.0, 1.2, 1.5708, -1.2, -1.5708])
+
+    @property
+    def base_xpos_offset(self):
+        return {
+            "bins": (-0.5, -0.1, 0),
+            "empty": (-0.6, 0, 0),
+            "table": lambda table_length: (-0.16 - table_length / 2, 0, 0),
+        }
+
+    @property
+    def top_offset(self):
+        return np.array((0, 0, 0.9))
+
+    @property
+    def _horizontal_radius(self):
+        return 0.65
+
+    @property
+    def arm_type(self):
+        return "single"
+
+    @property
+    def _eef_name(self):
+        return {"right": "right_hand"}
